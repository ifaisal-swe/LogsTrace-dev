# Copy to .env and fill in. Never commit .env.
# Values below work for local development (npm run dev). For Docker/production see docs/SELF_HOSTING.md.

# --- Databases (docker compose) ---
POSTGRES_USER=logstrace
# Required: long random string (openssl rand -hex 32)
POSTGRES_PASSWORD=
POSTGRES_DB=logstrace
POSTGRES_PORT=5432
# Required: password for the ClickHouse user "logstrace"
CLICKHOUSE_PASSWORD=

# --- App: database connections (local dev; docker compose sets these itself) ---
NUXT_DATABASE_URL=postgres://logstrace:<POSTGRES_PASSWORD>@localhost:5432/logstrace
# ClickHouse stores all log messages; Postgres keeps everything else
NUXT_CLICKHOUSE_URL=http://localhost:8123
NUXT_CLICKHOUSE_USER=logstrace
# Same value as CLICKHOUSE_PASSWORD (left empty = falls back to it in docker compose)
NUXT_CLICKHOUSE_PASSWORD=
NUXT_CLICKHOUSE_DATABASE=logstrace

# --- App: core ---
# Public origin. In production only this origin may make signed-in requests (CSRF and live socket)
NUXT_APP_URL=http://localhost:3000
# Long random string; encrypts two-step sign-in secrets. Required in production; never change it once set
NUXT_SECRET_KEY=
# Real client IP for rate limits and audit. Empty = last X-Forwarded-For hop (one reverse proxy).
# Behind Cloudflare: cf-connecting-ip (and only allow Cloudflare IPs to reach the server)
NUXT_TRUSTED_IP_HEADER=

# --- Accounts ---
# This email becomes platform admin (while none exists); admin rights need it verified
NUXT_BOOTSTRAP_ADMIN_EMAIL=
# Comma list of verified accounts that can open the owner dashboard (/app/admin)
NUXT_OWNER_EMAILS=
# open | invite | closed
NUXT_PUBLIC_REGISTRATION=open
# true = users must verify their email before using orgs (dev prints codes to the console)
NUXT_REQUIRE_EMAIL_VERIFICATION=false

# --- Email through Resend (https://resend.com) ---
# Verification codes, resets, invites, security notices. Without a key, dev prints emails
# to the console and production refuses to send.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=LogsTrace <no-reply@example.com>
NUXT_MAIL_REPLY_TO=

# --- Support tickets by email (optional) ---
# Resend receiving address + email.received webhook secret (endpoint: <app>/api/inbound/resend).
# Leave empty to answer in the app only.
NUXT_SUPPORT_INBOUND_ADDRESS=
NUXT_RESEND_WEBHOOK_SECRET=
NUXT_SUPPORT_AUTO_CLOSE_DAYS=7

# --- Platform events to Discord (optional) ---
# Sign-ups, new orgs/projects, support tickets, ... NUXT_PLATFORM_WEBHOOK_EVENTS accepts groups like ticket.*
NUXT_PLATFORM_WEBHOOK_URL=
NUXT_PLATFORM_WEBHOOK_EVENTS=
NUXT_PLATFORM_WEBHOOK_SHOW_EMAILS=false

# --- AI (optional) ---
# Dashboards from a description and questions to read-only query plans, through OpenRouter.
# The model only sees table shapes and masked sample values, never query results.
NUXT_OPENROUTER_API_KEY=
NUXT_AI_MODEL=deepseek/deepseek-v4.1-flash
NUXT_AI_FALLBACK_MODEL=deepseek/deepseek-v4-flash
# MCP endpoint at /api/mcp for AI tools (Claude, Cursor, ...). Needs a read API key; works without OpenRouter
NUXT_MCP_ENABLED=true
